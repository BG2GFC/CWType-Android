<?xml version="1.0" encoding="utf-8"?>
<!-- Remove ?attr/selectableItemBackground – requires Material theme -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:paddingLeft="8dp"
    android:paddingRight="8dp"
    android:paddingTop="5dp"
    android:paddingBottom="5dp"
    android:background="?attr/cwSurfaceAlt">

    <TextView android:id="@+id/tvLogTime"
        android:layout_width="0dp" android:layout_weight="1"
        android:textColor="?attr/cwTextDim" android:textSize="11sp"
        android:fontFamily="monospace" android:layout_height="wrap_content"/>

    <TextView android:id="@+id/tvLogCall"
        android:layout_width="0dp" android:layout_weight="2"
        android:textColor="?attr/cwAccent" android:textSize="12sp"
        android:fontFamily="monospace" android:textStyle="bold"
        android:layout_height="wrap_content"/>

    <TextView android:id="@+id/tvLogSent"
        android:layout_width="0dp" android:layout_weight="2"
        android:textColor="?attr/cwText" android:textSize="11sp"
        android:fontFamily="monospace" android:layout_height="wrap_content"/>

    <TextView android:id="@+id/tvLogRcvd"
        android:layout_width="0dp" android:layout_weight="2"
        android:textColor="?attr/cwText" android:textSize="11sp"
        android:fontFamily="monospace" android:layout_height="wrap_content"/>

    <TextView android:id="@+id/tvLogBand"
        android:layout_width="0dp" android:layout_weight="1"
        android:textColor="#FFD700" android:textSize="11sp"
        android:fontFamily="monospace" android:layout_height="wrap_content"/>

    <TextView android:id="@+id/tvLogNr"
        android:layout_width="0dp" android:layout_weight="1"
        android:textColor="?attr/cwTextDim" android:textSize="11sp"
        android:fontFamily="monospace" android:layout_height="wrap_content"/>

</LinearLayout>
