<?xml version="1.0" encoding="utf-8"?>
<!--
    N1MM-style main screen (portrait):
      top bar : row 1 – contest mode | frequency | WPM (-/slider/+)
                row 2 – RTS/DTR | serial | USB | menu | settings
      status  : last sent / CQ loop state
      left    : callsign + received exchange + TX hint + LOG/ABORT + paddle
      right   : F1-F12 macro grid
      bottom  : QSO log
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?attr/cwBackground">

    <!-- ══ TOP BAR ══════════════════════════════════════════════════════════
         Portrait: two rows. In one row the fixed-width items (WPM −/+, the
         WPM label, RTS/DTR/NR, USB/⋮/⚙) already fill a phone's width, which
         would squeeze the contest spinner and the WPM slider down to ~0dp. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="?attr/cwSurface"
        android:paddingStart="4dp"
        android:paddingEnd="4dp">

        <!-- ── row 1: contest mode · frequency · WPM ─────────────────────── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

        <Spinner
            android:id="@+id/spinnerContest"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="3"/>

        <TextView
            android:id="@+id/tvFreq"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="2"
            android:text="20m"
            android:textColor="?attr/cwAccentAlt"
            android:textSize="13sp"
            android:gravity="center"
            android:fontFamily="monospace"/>

        <Button
            android:id="@+id/btnWpmMinus"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:minWidth="0dp"
            android:padding="0dp"
            android:text="−"
            android:textSize="16sp"/>

        <SeekBar
            android:id="@+id/seekWpm"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="3"/>

        <Button
            android:id="@+id/btnWpmPlus"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:minWidth="0dp"
            android:padding="0dp"
            android:text="+"
            android:textSize="16sp"/>

        <TextView
            android:id="@+id/tvWpm"
            android:layout_width="62dp"
            android:layout_height="wrap_content"
            android:text="25 WPM"
            android:textColor="?attr/cwTextDim"
            android:textSize="11sp"
            android:gravity="center"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"/>

        </LinearLayout>

        <!-- ── row 2: keying lines · serial · USB · menu · settings ──────── -->
        <LinearLayout
            android:id="@+id/rowTopKeys"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

        <TextView
            android:id="@+id/tvRts"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="RTS○"
            android:textColor="?attr/cwTextDim"
            android:textSize="11sp"
            android:layout_marginStart="6dp"/>

        <TextView
            android:id="@+id/tvDtr"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="DTR○"
            android:textColor="?attr/cwTextDim"
            android:textSize="11sp"
            android:layout_marginStart="4dp"/>

        <TextView
            android:id="@+id/tvSerial"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="NR:001"
            android:textColor="#FFD700"
            android:textSize="11sp"
            android:fontFamily="monospace"
            android:layout_marginStart="6dp"/>

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1"/>

        <Button
            android:id="@+id/btnUsb"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:minWidth="0dp"
            android:text="USB"
            android:textSize="11sp"
            android:layout_marginStart="6dp"/>

        <Button
            android:id="@+id/btnMenu"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:minWidth="0dp"
            android:text="⋮"
            android:textSize="14sp"
            android:layout_marginStart="2dp"/>

        <Button
            android:id="@+id/btnSettings"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:minWidth="0dp"
            android:text="⚙"
            android:textSize="14sp"
            android:onClick="openSettings"
            android:layout_marginStart="2dp"/>

        </LinearLayout>

    </LinearLayout>

    <!-- ══ STATUS BAR ═══════════════════════════════════════════════════════ -->
    <TextView
        android:id="@+id/tvStatus"
        android:layout_width="match_parent"
        android:layout_height="22dp"
        android:text="就绪"
        android:textColor="?attr/cwTextDim"
        android:textSize="11sp"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:background="?attr/cwSurfaceAlt"
        android:gravity="center_vertical"
        android:fontFamily="monospace"
        android:singleLine="true"/>

    <!-- ══ MIDDLE: input panel, then the macro grid underneath ═══════════════
         Portrait: both blocks span the full width instead of sharing one row,
         so the callsign / exchange fields and the F1-F12 buttons all get the
         whole screen width. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="2dp">

        <!-- LEFT: callsign / exchange / paddle -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="?attr/cwSurfaceAlt"
            android:padding="6dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="呼号"
                android:textColor="?attr/cwTextDim"
                android:textSize="10sp"/>

            <EditText
                android:id="@+id/etCallsign"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="呼号 / 频率 (MHz)"
                android:textColor="?attr/cwText"
                android:textColorHint="?attr/cwTextDim"
                android:textSize="18sp"
                android:inputType="textVisiblePassword|textCapCharacters"
                android:imeOptions="actionNext"
                android:singleLine="true"
                android:background="?attr/cwField"
                android:padding="6dp"
                android:fontFamily="monospace"/>

            <TextView
                android:id="@+id/tvExchangeLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="收到交换"
                android:textColor="?attr/cwTextDim"
                android:textSize="10sp"
                android:layout_marginTop="4dp"/>

            <EditText
                android:id="@+id/etExchange"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="对方交换信息"
                android:textColor="?attr/cwAccentAlt"
                android:textColorHint="?attr/cwTextDim"
                android:textSize="15sp"
                android:inputType="textVisiblePassword|textCapCharacters"
                android:imeOptions="actionDone"
                android:singleLine="true"
                android:background="?attr/cwField"
                android:padding="6dp"
                android:fontFamily="monospace"
                android:layout_marginTop="2dp"/>

            <!-- What the operator must send for the current contest mode -->
            <TextView
                android:id="@+id/tvTxHint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="发: 599 00"
                android:textColor="?attr/cwTextDim"
                android:textSize="10sp"
                android:fontFamily="monospace"
                android:layout_marginTop="3dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="6dp">

                <Button
                    android:id="@+id/btnLog"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:minWidth="0dp"
                    android:text="记录 QSO"
                    android:textSize="11sp"/>

                <Button
                    android:id="@+id/btnAbort"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:minWidth="0dp"
                    android:text="■ 中止"
                    android:textSize="11sp"
                    android:layout_marginStart="4dp"/>

            </LinearLayout>

            <!-- Paddle: press and hold. Straight key / Iambic A / Iambic B -->
            <LinearLayout
                android:id="@+id/rowPaddle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="4dp">

                <Button
                    android:id="@+id/btnDot"
                    android:layout_width="0dp"
                    android:layout_height="42dp"
                    android:layout_weight="1"
                    android:minWidth="0dp"
                    android:text="· 点"
                    android:textSize="12sp"/>

                <Button
                    android:id="@+id/btnDash"
                    android:layout_width="0dp"
                    android:layout_height="42dp"
                    android:layout_weight="1"
                    android:minWidth="0dp"
                    android:text="— 划"
                    android:textSize="12sp"
                    android:layout_marginStart="4dp"/>

            </LinearLayout>
        </LinearLayout>

        <!-- RIGHT: F1-F12 macro grid (populated in code) -->
        <GridLayout
            android:id="@+id/macroGrid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:columnCount="4"
            android:rowCount="3"
            android:background="?attr/cwSurface"
            android:padding="2dp"
            android:layout_marginTop="2dp"/>

    </LinearLayout>

    <!-- ══ LOG HEADER ════════════════════════════════════════════════════════ -->
    <LinearLayout
        android:id="@+id/rowLogHeader"
        android:layout_width="match_parent"
        android:layout_height="22dp"
        android:orientation="horizontal"
        android:background="?attr/cwSurface"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:layout_marginTop="2dp">

        <TextView android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="match_parent"
            android:text="时间" android:textColor="?attr/cwTextDim"
            android:textSize="10sp" android:fontFamily="monospace"
            android:gravity="center_vertical"/>
        <TextView android:layout_width="0dp" android:layout_weight="2"
            android:layout_height="match_parent"
            android:text="呼号" android:textColor="?attr/cwTextDim"
            android:textSize="10sp" android:fontFamily="monospace"
            android:gravity="center_vertical"/>
        <TextView android:layout_width="0dp" android:layout_weight="2"
            android:layout_height="match_parent"
            android:text="发出" android:textColor="?attr/cwTextDim"
            android:textSize="10sp" android:fontFamily="monospace"
            android:gravity="center_vertical"/>
        <TextView android:layout_width="0dp" android:layout_weight="2"
            android:layout_height="match_parent"
            android:text="收到" android:textColor="?attr/cwTextDim"
            android:textSize="10sp" android:fontFamily="monospace"
            android:gravity="center_vertical"/>
        <TextView android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="match_parent"
            android:text="波段" android:textColor="?attr/cwTextDim"
            android:textSize="10sp" android:fontFamily="monospace"
            android:gravity="center_vertical"/>
        <TextView android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="match_parent"
            android:text="#" android:textColor="?attr/cwTextDim"
            android:textSize="10sp" android:fontFamily="monospace"
            android:gravity="center_vertical"/>
    </LinearLayout>

    <!-- ══ QSO LOG LIST ══════════════════════════════════════════════════════ -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvLog"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="?attr/cwBackground"/>

</LinearLayout>
